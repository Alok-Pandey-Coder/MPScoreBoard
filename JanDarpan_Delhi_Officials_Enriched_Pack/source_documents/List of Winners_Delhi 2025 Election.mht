@charset "utf-8";

.modal { display: none; position: fixed; z-index: 9999; left: 0px; top: 0px; width: 100%; height: 100%; overflow: auto; background-color: rgba(0, 0, 0, 0.4); box-sizing: border-box; }

.modal-content { position: relative; background-color: rgb(254, 254, 254); margin: 20px auto; padding: 20px; border: 1px solid rgb(136, 136, 136); width: 80%; height: calc(100% - 40px); box-sizing: border-box; }

.modal-content iframe { display: block; width: 100%; height: 95%; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; }

.close, .close_2 { color: rgb(170, 170, 170); float: right; font-size: 28px; font-weight: bold; }

.close:hover, .close:focus, .close_2:hover, .close_2:focus { color: rgb(0, 0, 0); text-decoration: none; cursor: pointer; }
