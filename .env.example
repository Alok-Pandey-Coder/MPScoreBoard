# Copy to .env.local. Every variable is optional: without them the app runs
# fully from the static snapshot and uses template summaries.

# "Explain simply" LLM summary (server-side only; never exposed to the browser).
# Both must be set, or /api/summary falls back to the template summary.
GEMINI_API_KEY=
# A current Gemini model id from https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=

# Absolute site URL used for canonical and Open Graph links, e.g. https://example.vercel.app
NEXT_PUBLIC_SITE_URL=

# YugabyteDB (YSQL, PostgreSQL protocol) — OPTIONAL.
# Put this file at the PROJECT ROOT (next to package.json) and name it .env (or .env.local).
# It is git-ignored; never commit it and never put it in public/.
#
# Leave DATABASE_URL unset and the site uses the JSON snapshot in data/processed/mps.json,
# exactly as before: no Docker or database needed. If it is set but the database cannot be
# reached, the site falls back to the JSON snapshot; check GET /api/health (dataSource, database).
#
# Local Docker database: `docker compose up -d yugabyte`, `python scripts/load_db.py --schema`, then
# DATABASE_URL=postgresql://yugabyte:yugabyte@localhost:5433/yugabyte
#
# YugabyteDB Aeon (hosted), on your computer. Percent-encode special characters in the password
# (@ is %40, : is %3A, / is %2F, # is %23). certs/root.crt is the cluster's public CA certificate:
# DATABASE_URL=postgresql://<user>:<password>@<cluster-host>:5433/yugabyte?sslmode=verify-full&sslrootcert=certs/root.crt
#
# YugabyteDB Aeon on Vercel (no files available): set DATABASE_URL WITHOUT any ssl parameters, and
# put the certificate text (the content of certs/root.crt) in DATABASE_CA_CERT:
# DATABASE_URL=postgresql://<user>:<password>@<cluster-host>:5433/yugabyte
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----...-----END CERTIFICATE-----"
